#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
  behaviors {
    bhm: balanced_homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <200>;
      quick-tap-ms = <0>;
      flavor = "balanced";
      bindings = <&kp>, <&kp>;
    }; 

    mlt: mouse_layer_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <200>;
      quick-tap-ms = <0>;
      flavor = "balanced";
      bindings = <&mo>, <&mkp>;
    };

    bmm: balanced_mouserow_mods {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <200>;
      quick-tap-ms = <0>;
      flavor = "balanced";
      bindings = <&kp>, <&mkp>;
    };
  };

  combos {
    compatible = "zmk,combos";
    combo_esc {
      timeout-ms = <50>;
      key-positions = <0 1>;
      bindings = <&kp ESC>;
    };
    
    combo_middleclick {
      timeout-ms = <50>;
      key-positions = <12 13>;
      bindings = <&mlt 2 MCLK>;
    };

    combo_middlepress {
      timeout-ms = <50>;
      key-positions = <16 17>;
      bindings = <&mkp MCLK>;
    };

    combo_bootload {
      timeout-ms = <50>;
      key-positions = <0 30>;
      bindings = <&bootloader>;
    };

    combo_sysreset {
      timeout-ms = <50>;
      key-positions = <0 24>;
      bindings = <&sys_reset>;
    };
  };

  trackball_listener {
          compatible = "zmk,input-listener";
          device = <&trackball>;
          input-processors = <&zip_xy_scaler 1 5>,<&zip_temp_layer 3 250>;
          scroll{
              layers = <2>;
              input-processors = <&zip_xy_scaler 1 100>, <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform (INPUT_TRANSFORM_Y_INVERT)>;
          };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp Q           &kp W         &kp E         &kp R         &kp T         &kp Y       &kp U           &kp I         &kp O         &kp P
        &bhm LSHIFT A   &bhm LALT S   &bhm LGUI D   &bhm LCTRL F  &kp G         &kp H       &bhm LCTRL J    &bhm LGUI K   &bhm LALT L   &bhm LSHIFT SEMI
        &kp Z           &kp X         &kp C         &kp V         &kp B         &kp N       &kp M           &kp CMMA      &kp DOT       &kp FSLH
                                                                  &lt 1 SPACE   &lt 2 BSPC  &lt 3 ENTER
      >;
    };

    lower_layer {
      bindings = <
        &kp F7          &kp F5        &kp F3        &kp F1        &kp F9        &kp F10     &kp F2          &kp  F4       &kp F6        &kp F8
        &bhm LSHIFT N7  &bhm LALT N5  &bhm LGUI N3  &bhm LCTRL N1 &kp N9        &kp N0      &bhm LCTRL N2   &bhm LGUI N4  &bhm LALT N6  &bhm LSHIFT N8
        &kp BSLH        &kp SQT       &none         &none         &none         &none       &kp LBKT        &kp RBKT      &kp MINUS     &kp EQUAL
                                                                  &none         &kp BSPC    &kp PAUSE_BREAK
      >;
    };

    raise_layer {
      bindings = <
        &kp ESC         &kp HOME      &kp UP        &kp END       &none         &bootloader &tog 5          &tog 6        &none         &kp DEL
        &kp TAB         &kp LEFT      &kp DOWN      &kp RIGHT     &none         &none       &kp LCTRL       &kp LGUI      &kp LALT      &bhm LSHIFT K_CMENU
        &none           &kp C_PREV    &kp C_PP      &kp C_NEXT    &none         &sys_reset  &none           &none         &none         &none
                                                                  &kp SPACE     &none       &none
      >;
    };

    mouse_layer {
      bindings = <
        &kp Q           &kp W         &kp E         &kp R         &kp T         &kp Y       &kp U           &kp I         &kp O         &kp P
        &bhm LSHIFT A   &bhm LALT S   &mkp RCLK     &mkp LCLK     &kp G         &kp H       &bhm LCTRL J    &bhm LGUI K   &bhm LALT L   &bhm LSHIFT SEMI
        &kp Z           &kp X         &kp C         &kp V         &kp B         &kp N       &kp M           &kp CMMA      &kp DOT       &kp FSLH
                                                                  &kp SPACE     &kp BSPC    &kp ENTER
      >;
    };

    fusion_layer {
      bindings = <
        &kp Q           &kp W         &kp E         &kp R         &kp T         &kp Y       &kp U           &kp I         &kp O         &kp P
        &bmm A RS(MCLK) &bhm LALT S   &bhm LGUI D   &bhm LCTRL F  &kp G         &kp H       &bhm LCTRL J    &bhm LGUI K   &bhm LALT L   &bhm LSHIFT SEMI
        &kp Z           &kp X         &kp C         &kp V         &kp B         &kp N       &kp M           &kp CMMA      &kp DOT       &kp FSLH
                                                                  &lt 1 SPACE   &lt 2 BSPC  &lt 3 ENTER
      >;
    };

    gaming_layer {
      bindings = <
        &kp TAB         &kp Q         &kp W         &kp E         &kp R         &kp T       &kp Z           &kp U         &kp I       &kp O
        &kp LSHIFT      &kp A         &kp S         &kp D         &kp F         &kp G       &mkp LCLK       &mkp RCLK     &kp K       &kp L
        &kp LCTRL       &kp Y         &kp X         &kp C         &kp V         &kp B       &kp N           &kp M         &kp CMMA    &kp DOT
                                                                  &lt 1 SPACE   &lt 2 BSPC  &lt 3 ENTER
      >;
    };
  };
};
